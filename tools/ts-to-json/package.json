{
  "name": "@nerv/ts-to-json",
  "private": true,
  "type": "module",
  "description": "Convert withfig/autocomplete TypeScript specs into Nerv JSON",
  "scripts": {
    "convert": "NODE_PATH=$PWD/node_modules bun convert.ts",
    "convert:one": "NODE_PATH=$PWD/node_modules bun convert.ts --input ../../vendor/withfig-autocomplete/src/hostname.ts --output /tmp/hostname.json",
    "convert:all": "NODE_PATH=$PWD/node_modules bun convert.ts --input ../../vendor/withfig-autocomplete/src/ --output ../../crates/nerv-engine/tests/fixtures/converted/ --verbose",
    "test": "bun test"
  },
  "dependencies": {
    "@fig/autocomplete-generators": "^2.4.0"
  }
}
